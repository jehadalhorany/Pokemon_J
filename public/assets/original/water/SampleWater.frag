precision highp float;
precision highp int;
uniform 	vec4 _Time;
uniform 	vec3 _WorldSpaceCameraPos;
uniform 	vec4 _ZBufferParams;
uniform 	mediump vec4 _WorldSpaceLightPos0;
uniform 	mediump vec4 _LightColor0;
uniform 	vec4 _WaterColor;
uniform 	float _WaterSpeedX;
uniform 	float _WaterSpeedY;
uniform 	vec4 _Normal2_ST;
uniform 	float _NormalScale;
uniform 	float _WaterNoiseSpeedX;
uniform 	float _WaterNoiseSpeedY;
uniform 	vec4 _WaterNormal_ST;
uniform 	float _Smoothness;
uniform 	float _Specular;
uniform 	float _Deep;
uniform 	float _Distance;
uniform mediump sampler2D _Normal2;
uniform mediump sampler2D _WaterNormal;
uniform highp sampler2D _CameraDepthTexture;
in highp vec2 vs_TEXCOORD0;
in highp vec3 vs_TEXCOORD1;
in highp vec3 vs_TEXCOORD2;
in highp vec4 vs_TEXCOORD3;
out mediump vec4 SV_Target0;
vec3 u_xlat0;
mediump vec3 u_xlat16_0;
mediump vec3 u_xlat16_1;
mediump vec3 u_xlat16_2;
mediump vec3 u_xlat16_3;
vec3 u_xlat4;
float u_xlat5;
float u_xlat15;
void main()
{
    u_xlat0.xy = vs_TEXCOORD0.xy * _WaterNormal_ST.xy + _WaterNormal_ST.zw;
    u_xlat0.xy = _Time.yy * vec2(_WaterNoiseSpeedX, _WaterNoiseSpeedY) + u_xlat0.xy;
    u_xlat16_0.xyz = texture(_WaterNormal, u_xlat0.xy).xyz;
    u_xlat16_1.xyz = u_xlat16_0.xyz * vec3(2.0, 2.0, 2.0) + vec3(-1.0, -1.0, -1.0);
    u_xlat16_1.xy = u_xlat16_1.xy * vec2(_NormalScale);
    u_xlat0.xy = vs_TEXCOORD0.xy * _Normal2_ST.xy + _Normal2_ST.zw;
    u_xlat0.xy = _Time.yy * vec2(_WaterSpeedX, _WaterSpeedY) + u_xlat0.xy;
    u_xlat16_0.xyz = texture(_Normal2, u_xlat0.xy).xyz;
    u_xlat16_2.xyz = u_xlat16_0.xyz * vec3(2.0, 2.0, 2.0) + vec3(-1.0, -1.0, -1.0);
    u_xlat16_3.xy = u_xlat16_2.xy * vec2(_NormalScale) + u_xlat16_1.xy;
    u_xlat16_3.z = u_xlat16_1.z * u_xlat16_2.z;
    u_xlat16_1.x = dot(u_xlat16_3.xyz, u_xlat16_3.xyz);
    u_xlat16_1.x = inversesqrt(u_xlat16_1.x);
    u_xlat16_1.xyz = u_xlat16_1.xxx * u_xlat16_3.xyz;
    u_xlat0.xyz = (-vs_TEXCOORD2.xyz) + _WorldSpaceCameraPos.xyz;
    u_xlat15 = dot(u_xlat0.xyz, u_xlat0.xyz);
    u_xlat15 = inversesqrt(u_xlat15);
    u_xlat0.xyz = vec3(u_xlat15) * u_xlat0.xyz;
    u_xlat0.x = dot(u_xlat0.xyz, u_xlat16_1.xyz);
    u_xlat0.x = log2(u_xlat0.x);
    u_xlat5 = _Smoothness * 5.0;
    u_xlat0.x = u_xlat0.x * u_xlat5;
    u_xlat0.x = exp2(u_xlat0.x);
    u_xlat0.x = u_xlat0.x * _Specular;
    u_xlat0.x = clamp(u_xlat0.x, 0.0, 1.0);
    u_xlat0.xyz = u_xlat0.xxx + _WaterColor.xyz;
    u_xlat15 = vs_TEXCOORD3.w + 9.99999996e-12;
    u_xlat4.xyz = vs_TEXCOORD3.xyz / vec3(u_xlat15);
    u_xlat15 = texture(_CameraDepthTexture, u_xlat4.xy).x;
    u_xlat4.x = u_xlat4.z * 0.5 + 0.5;
    u_xlat4.x = _ZBufferParams.z * u_xlat4.x + _ZBufferParams.w;
    u_xlat4.x = float(1.0) / u_xlat4.x;
    u_xlat15 = _ZBufferParams.z * u_xlat15 + _ZBufferParams.w;
    u_xlat15 = float(1.0) / u_xlat15;
    u_xlat15 = (-u_xlat4.x) + u_xlat15;
    u_xlat15 = u_xlat15 / _Distance;
    u_xlat4.x = (-_Deep) + 1.0;
    u_xlat15 = abs(u_xlat15) * u_xlat4.x + _Deep;
    u_xlat15 = clamp(u_xlat15, 0.0, 1.0);
    u_xlat4.x = (-u_xlat15) + 0.699999988;
    SV_Target0.w = u_xlat15;
    u_xlat15 = max(u_xlat4.x, 0.0);
    u_xlat0.xyz = vec3(u_xlat15) * vec3(0.5, 0.5, 0.5) + u_xlat0.xyz;
    u_xlat15 = dot(vs_TEXCOORD1.xyz, vs_TEXCOORD1.xyz);
    u_xlat15 = inversesqrt(u_xlat15);
    u_xlat4.xyz = vec3(u_xlat15) * vs_TEXCOORD1.xyz;
    u_xlat15 = dot(u_xlat4.xyz, _WorldSpaceLightPos0.xyz);
    u_xlat15 = clamp(u_xlat15, 0.0, 1.0);
    u_xlat16_1.xyz = vec3(u_xlat15) * _LightColor0.xyz;
    SV_Target0.xyz = u_xlat0.xyz * u_xlat16_1.xyz;
    return;
}